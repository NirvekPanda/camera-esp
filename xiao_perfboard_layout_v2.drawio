480.0" as="sourcePoint"/><mxPoint x="360.0" y="480.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c352" style="endArrow=oval;startArrow=oval;endFill=1;startFill=1;endSize=5;startSize=5;strokeWidth=3;strokeColor=#6a00ff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320.0" y="520.0" as="sourcePoint"/><mxPoint x="360.0" y="520.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c353" style="endArrow=oval;startArrow=oval;endFill=1;startFill=1;endSize=5;startSize=5;strokeWidth=3;strokeColor=#6a00ff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160.0" y="480.0" as="sourcePoint"/><mxPoint x="360.0" y="560.0" as="targetPoint"/><Array as="points"><mxPoint x="200.0" y="480.0"/><mxPoint x="200.0" y="560.0"/></Array></mxGeometry></mxCell><mxCell id="c354" value="OFF-GRID&lt;br&gt;Shutter keyboard switch&lt;br&gt;leg 1 to XIAO pad D11&lt;br&gt;leg 2 to GND" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="200" height="70" as="geometry"/></mxCell><mxCell id="c355" value="OFF-GRID&lt;br&gt;XIAO top pad D12" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="580" y="660" width="150" height="44" as="geometry"/></mxCell><mxCell id="c356" style="endArrow=oval;startArrow=oval;endFill=1;startFill=1;endSize=5;startSize=5;strokeWidth=3;strokeColor=#000000;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="660" as="sourcePoint"/><mxPoint x="200.0" y="614.0" as="targetPoint"/><Array as="points"><mxPoint x="160" y="614.0"/></Array></mxGeometry></mxCell><mxCell id="c357" style="endArrow=oval;startArrow=oval;endFill=1;startFill=1;endSize=5;startSize=5;strokeWidth=3;strokeColor=#1ba1e2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600.0" y="80.0" as="sourcePoint"/><mxPoint x="730" y="682" as="targetPoint"/><Array as="points"><mxPoint x="600.0" y="30"/><mxPoint x="760" y="30"/><mxPoint x="760" y="682"/></Array></mxGeometry></mxCell><mxCell id="c358" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Black = GND (row 1 is the ground bus)&lt;br&gt;Red = 3V3 (feeds RES and VCC). BLK left unconnected: most modules have the backlight on by default&lt;br&gt;Dashed = flying wire, off the grid&lt;br&gt;No wires between the XIAO pin columns (I to M, rows 2 to 8)&lt;br&gt;Wires that cross are NOT connected. Use insulated wire for those.&lt;br&gt;Buttons: only diagonal legs are wired (always switch in any rotation)&lt;br&gt;5-way labels (UP/DWN/etc) are a guess. Check with a multimeter, then swap in code." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="680" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>