#!/usr/bin/env bash
# Blocks pushes to main and pushes that fail lint, types, unit, build or integration tests.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

while read -r _ _ remote_ref _; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    echo "pre-push: push to main is blocked. Use a feature branch and open a PR." >&2
    exit 1
  fi
done

cd "$(git rev-parse --show-toplevel)/web"
npm run check
